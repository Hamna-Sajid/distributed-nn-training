# Dockerfile.master — Master node container
# Builds a self-contained image that runs the master training coordinator.
#
# The master:
#   - Loads the MNIST dataset
#   - Accepts connections from worker containers
#   - Runs the full distributed training loop
#   - Saves the final model and performance report to mounted volumes

FROM python:3.12-slim

WORKDIR /app

# Install dependencies first (cached layer — only rebuilds if requirements change)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy entire project
COPY . .

# Create output directories that will be mounted as volumes
RUN mkdir -p logs saved_models benchmark_results graphs

# Environment variables with sensible defaults
# Override these in docker-compose.yml
ENV PYTHONUNBUFFERED=1
ENV MASTER_HOST=0.0.0.0
ENV MASTER_PORT=5000
ENV N_WORKERS=2
ENV N_EPOCHS=10
ENV N_SAMPLES=10000

CMD ["python", "run_master.py"]